# Copy to .env (never commit .env)
# Default: local Ollama; no hosted API key required.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5vl:7b
ANTHROPIC_API_KEY=
WHISPER_MODEL=small          # tiny|base|small|medium ; weights download once from Hugging Face
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=90
FRAME_INTERVAL_S=60
MAX_FRAMES_FOR_LLM=8
MIN_TRANSCRIPT_WORDS=40
MIN_ELIGIBLE_WEIGHT=0.5
